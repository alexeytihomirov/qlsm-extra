# Plugins deploy to Linux QL hosts; addons run on Linux qlsm hosts.
# Normalize to LF regardless of platform or per-user core.autocrlf.
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.sh text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.ini text eol=lf
*.svg text eol=lf
*.j2 text eol=lf
*.txt text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Addon packages are archives: never touch their bytes, the repository index
# carries a sha256 of exactly what is committed here.
*.zip binary

# Pinned host keys shipped to game hosts.
known_hosts_vps text eol=lf

# Host-metrics fixtures are byte copies of /proc and cgroup files.
tests/fixtures/host-metrics/** -text

# Static linux/amd64 build of addons/server-ping/echo (build.sh).
addons/server-ping/assets/ql-ping-echo binary
# Shell script without an extension, run by /bin/sh on the host.
addons/server-ping/assets/ql-ping-firewall text eol=lf
